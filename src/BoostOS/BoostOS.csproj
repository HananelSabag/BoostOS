<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BoostOS</AssemblyName>
    <RootNamespace>BoostOS</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.3</Version>
    <Product>BoostOS</Product>
    <Authors>Hananel Sabag</Authors>
    <Description>A console-style home screen for Windows that gets your PC ready for Rocket League.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- wwwroot\dev holds a sample scan for designing in a plain browser; it never ships. -->
    <None Include="wwwroot\**\*" Exclude="wwwroot\dev\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BoostOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control too; this is a WinForms app, so drop it. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
